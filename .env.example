# ============================================
# SoSpark Design v2 — Environment Variables
# ============================================

# ── Server ──
NODE_ENV=development
PORT=3000

# ── MongoDB ──
# Atlas connection string — include /sosparkdesign before the ?
MONGODB_URI=mongodb+srv://zoktanianaani338_db_user:YOUR_PASSWORD@cluster0.r7divhm.mongodb.net/sosparkdesign?appName=Cluster0

# ── JWT ──
